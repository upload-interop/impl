{
    "name": "upload-interop/impl",
    "type": "library",
    "description": "",
    "keywords": [],
    "license": "MIT",
    "homepage": "https://github.com/upload-interop/impl",
    "authors": [
        {
            "name": "Paul M. Jones",
            "email": "pmjones@pmjones.io",
            "homepage": "https://pmjones.io",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.4",
        "upload-interop/interface": "1.x@dev"
    },
    "autoload": {
        "psr-4" : {
            "UploadInterop\\Impl\\": "src/"
        }
    },
    "require-dev": {
        "pds/composer-script-names": "^1.0",
        "pds/skeleton": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4" : {
            "UploadInterop\\Impl\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "./vendor/bin/phpstan",
        "check": "composer test && composer analyze",
        "test": "./vendor/bin/phpunit",
        "test-coverage": "./vendor/bin/phpunit --coverage-html=./tmp/coverage"
    }
}
